{{!
    @template local_rapidcmi5/projects_list

    Template for the RapidCMI5 projects list page.
}}
<div class="local-rapidcmi5-projects">
    <div class="rcmi-toolbar">
        <form method="get" action="{{{searchurl}}}">
            <div class="input-group">
                <input aria-label="{{#str}}searchprojects, local_rapidcmi5{{/str}}" type="search" name="search" value="{{search}}" class="form-control"
                       placeholder="{{#str}}search, local_rapidcmi5{{/str}}..." />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary">{{#str}}search, local_rapidcmi5{{/str}}</button>
                </div>
            </div>
            {{#search}}<a class="rcmi-clear-search" href="{{{searchurl}}}">{{#str}}clearcoursesearch, local_rapidcmi5{{/str}}</a>{{/search}}
        </form>
        <a href="{{{uploadurl}}}" class="btn btn-primary">{{#str}}uploadpackage, local_rapidcmi5{{/str}}</a>
    </div>

    {{#hasprojects}}
    <div class="rcmi-table-panel table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">{{#str}}projectname, local_rapidcmi5{{/str}}</th>
                <th scope="col">{{#str}}projectidentifier, local_rapidcmi5{{/str}}</th>
                <th scope="col">{{#str}}currentversion, local_rapidcmi5{{/str}}</th>
                <th scope="col">{{#str}}gitrepo, local_rapidcmi5{{/str}}</th>
                <th scope="col">{{#str}}lastmodified, local_rapidcmi5{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#projects}}
            <tr>
                <td><a href="{{{detailurl}}}">{{name}}</a></td>
                <td><code>{{identifier}}</code></td>
                <td>{{#currentversion}}<span class="badge badge-info">{{currentversion}}</span>{{/currentversion}}</td>
                <td>{{#hasgitrepo}}<a href="{{gitrepourl}}" target="_blank" rel="noopener">{{#str}}viewrepository, local_rapidcmi5{{/str}}</a>{{/hasgitrepo}}</td>
                <td>{{timemodified}}</td>
            </tr>
            {{/projects}}
        </tbody>
    </table>
    </div>
    {{/hasprojects}}

    {{^hasprojects}}
    <div class="alert alert-info rcmi-empty-state">{{#str}}noprojects, local_rapidcmi5{{/str}}</div>
    {{/hasprojects}}
</div>
