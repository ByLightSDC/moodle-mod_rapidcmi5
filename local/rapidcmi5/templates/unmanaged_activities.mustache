{{!
    @template local_rapidcmi5/unmanaged_activities

    Template for the unmanaged RapidCMI5 activities scanner page.
}}
<div class="local-rapidcmi5-unmanaged">

    {{#hasactivities}}
    <div class="rcmi-table-panel table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">{{#str}}course, local_rapidcmi5{{/str}}</th>
                <th scope="col">{{#str}}activityname, local_rapidcmi5{{/str}}</th>
                <th scope="col">{{#str}}playerversion, local_rapidcmi5{{/str}}</th>
                <th scope="col">{{#str}}aucount, local_rapidcmi5{{/str}}</th>
                <th scope="col">{{#str}}actions, local_rapidcmi5{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#activities}}
            <tr>
                <td>{{coursename}}</td>
                <td>{{activityname}}</td>
                <td>{{playerversion}}</td>
                <td>{{aucount}}</td>
                <td>
                    {{#canmanage}}
                    <a class="btn btn-sm btn-primary mr-2" href="{{{manageurl}}}">
                        {{#str}}addtomanaged, local_rapidcmi5{{/str}}
                    </a>
                    {{/canmanage}}
                    {{#hasplayerversions}}
                    <form method="post" action="{{{actionurl}}}" class="rcmi-inline-form"
                          onsubmit="return confirm('{{#str}}upgradeplayerconfirm, local_rapidcmi5{{/str}}');">
                        <input type="hidden" name="action" value="upgradeplayer">
                        <input type="hidden" name="cmid" value="{{cmid}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="returnurl" value="{{{returnurl}}}">
                        <div class="rcmi-action-group d-inline-flex align-items-center">
                            <select aria-label="{{#str}}playerversion, local_rapidcmi5{{/str}}" name="playerversionid" class="custom-select custom-select-sm mr-1">
                                {{#playeroptions}}
                                <option value="{{id}}">{{label}}</option>
                                {{/playeroptions}}
                            </select>
                            <button type="submit" class="btn btn-sm btn-warning">
                                {{#str}}setplayer, local_rapidcmi5{{/str}}
                            </button>
                        </div>
                    </form>
                    {{/hasplayerversions}}
                </td>
            </tr>
            {{/activities}}
        </tbody>
    </table>
    </div>
    {{/hasactivities}}

    {{^hasactivities}}
    <div class="alert alert-info rcmi-empty-state">{{#str}}nounmanaged, local_rapidcmi5{{/str}}</div>
    {{/hasactivities}}
</div>
